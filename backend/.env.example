# Server
NODE_ENV=development
PORT=4000
# Comma-separated browser origins. The Android app does not use CORS.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Database. The local MySQL84 service on this machine listens on port 3307.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3307/smartpantry"

# Auth: generate each with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Google sign-in: the OAuth *Web* client ID (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=

# External APIs. Leave blank to disable; dependent endpoints return 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SPOONACULAR_API_KEY=
# "1" is TheMealDB's public test key for development.
THEMEALDB_API_KEY=1

# Password reset email. Without SMTP_HOST, forgot-password returns 503 in
# production and logs the reset token to the server console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartPantry AI <no-reply@example.com>"
